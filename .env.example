# Backend (backend/ klasöründe veya kökte export edilebilir)
DATABASE_URL=postgresql://postgres:123456@127.0.0.1:5432/eldenele_db
JWT_SECRET=elden-ele-dev-secret-change-me
JWT_EXPIRE_HOURS=24
JWT_REFRESH_EXPIRE_DAYS=30
ADMIN_API_KEY=dev-admin-key-change-me

# Iyzico sandbox (opsiyonel — yoksa simülasyon modu)
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
FRONTEND_URL=http://localhost:3000
# Production: Vercel adresiniz + localhost (CORS)
ALLOWED_ORIGINS=http://localhost:3000,https://rentingapp-gules.vercel.app

# Frontend (.env.local veya Vercel Environment Variables)
NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:8000
# Production örneği (Vercel'de Render backend URL'nizi yazın):
# NEXT_PUBLIC_BACKEND_URL=https://your-app.onrender.com

# Google Gemini — AI İlan Asistanı (POST /ai/generate-listing)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Google OAuth (backend/.env + frontend/.env.local)
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Google Maps (frontend/.env.local — Maps JavaScript API + Places API etkin olmalı)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
